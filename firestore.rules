rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedCloudEmail() {
      return request.auth != null
        && request.auth.token.email in ['rebirth1013@gmail.com'];
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isAllowedCloudEmail() && request.auth.uid == userId;
    }

    match /localLicenses/{email} {
      allow read: if isAllowedCloudEmail()
        || (request.auth != null
          && resource.data.active == true
          && request.auth.token.email == resource.data.email);
      allow write: if isAllowedCloudEmail();
    }

    match /accessRequests/{requestId} {
      allow read: if isAllowedCloudEmail()
        || (request.auth != null && request.auth.uid == requestId);

      allow create: if request.auth != null
        && request.auth.uid == requestId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.active == false;

      allow update: if isAllowedCloudEmail()
        || (request.auth != null
          && request.auth.uid == requestId
          && resource.data.status != 'approved'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.status == 'pending'
          && request.resource.data.active == false);

      allow delete: if isAllowedCloudEmail();
    }
  }
}
